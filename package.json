{
  "name": "basketball-stats-warehouse",
  "version": "1.0.0",
  "description": "D3 Women's Basketball Statistics Warehouse",
  "main": "build.js",
  "scripts": {
    "build": "node build.js build",
    "dev": "node build.js dev",
    "clean": "node build.js clean",
    "wrap-reports": "node wrap-reports.js",
    "serve": "npx serve -p 8000",
    "start": "npm run build && npm run serve",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint '**/*.js' --fix",
    "lint:css": "stylelint '**/*.css' --fix --ignore-path .gitignore",
    "lint:check": "npm run lint:check:js && npm run lint:check:css",
    "lint:check:js": "eslint '**/*.js'",
    "lint:check:css": "stylelint '**/*.css' --ignore-path .gitignore",
    "format": "prettier --write '**/*.{js,css,html,json,md}'",
    "format:check": "prettier --check '**/*.{js,css,html,json,md}'",
    "verify": "npm run format:check && npm run lint:check",
    "prepare": "husky"
  },
  "keywords": [
    "basketball",
    "statistics",
    "d3",
    "sports"
  ],
  "author": "Basketball Stats Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0"
  },
  "lint-staged": {
    "*.{js,css,html,json,md}": "prettier --write",
    "*.js": "eslint --fix",
    "*.css": "stylelint --fix"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
